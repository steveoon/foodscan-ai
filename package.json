		"preview": "vite preview",
		"tauri": "tauri",
		"prepare": "husky"
	},
	"dependencies": {
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@tauri-apps/cli": "^2",
		"@types/react": "^18.3.1",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"husky": "^9.1.7",
		"lint-staged": "^15.4.3",
		"typescript": "~5.6.2",
		"vite": "^6.0.3"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,css,json}": ["biome check --write ./src"]
	}
