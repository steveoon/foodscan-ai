{
	"name": "tauri-app",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"lint": "biome check --write ./src",
		"clean": "cd src-tauri && cargo clean",
		"init:ios": "tauri ios init",
		"init:android": "tauri android init",
		"biome": "biome check --write ./src",
